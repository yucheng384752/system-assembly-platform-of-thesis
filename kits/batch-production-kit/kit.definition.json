{
  "id": "batch-production-kit",
  "displayName": "批次生產紀錄",
  "category": "core",
  "required": false,
  "businessCapability": "開立批次工單、派工，讓現場依產品定義的站點逐項填寫量測、秤重用料並簽核，全部完成後結案。",
  "dependencies": [
    "platform-core-kit",
    "entry-permission-kit",
    "product-process-kit"
  ],
  "optionalDependencies": [
    "alarm-exception-kit",
    "equipment-maintenance-kit",
    "production-dashboard-kit",
    "runtime-settings-kit"
  ],
  "backend": {
    "routers": [
      "src/backend/app/api/routes_batches.py",
      "src/backend/app/api/routes_extras.py"
    ],
    "core": [
      "src/backend/app/core/events.py",
      "src/backend/app/core/gates.py",
      "src/backend/app/core/lot_number.py",
      "src/backend/app/core/progress.py",
      "src/backend/app/core/completion.py",
      "src/backend/app/core/material_rules.py",
      "src/backend/app/core/assignment.py",
      "src/backend/app/core/measurement_rules.py",
      "src/backend/app/core/batch_settings.py",
      "src/backend/app/core/extension_points.py",
      "src/backend/app/core/batch_entry_points.py",
      "src/backend/app/core/batch_read.py",
      "src/backend/app/core/warehouse_rules.py",
      "src/backend/app/core/rework_rules.py",
      "src/backend/app/core/note_rules.py",
      "src/backend/app/core/attachment_rules.py",
      "src/backend/app/core/extras_settings.py",
      "src/backend/app/core/extras_startup.py",
      "src/backend/app/core/batch_params.py"
    ],
    "services": [],
    "models": [
      "src/backend/app/models/batch.py",
      "src/backend/app/models/measurement.py",
      "src/backend/app/models/batch_material.py",
      "src/backend/app/models/lot_serial_counter.py",
      "src/backend/app/models/extras.py"
    ],
    "routerRegistrations": [
      {
        "module": "app.api.routes_batches",
        "symbol": "router",
        "prefix": "",
        "tags": [
          "batches"
        ],
        "tenantScoped": false
      }
    ],
    "schemas": [
      "src/backend/app/schemas/batch.py",
      "src/backend/app/schemas/extras.py"
    ]
  },
  "frontend": {
    "pages": [],
    "components": [],
    "services": [],
    "note": "前端（開單、派工、表單填寫、簽核）於後續工作包抽出"
  },
  "api": [
    "POST /batches",
    "POST /batches/{batch_id}/dispatch",
    "GET /batches",
    "GET /batches/{batch_id}",
    "PATCH /batches/{batch_id}",
    "DELETE /batches/{batch_id}",
    "POST /batches/{batch_id}/measurements",
    "GET /batches/{batch_id}/measurements",
    "GET /batches/{batch_id}/materials",
    "PUT /batches/{batch_id}/materials",
    "POST /batches/{batch_id}/sign",
    "POST /batches/{batch_id}/complete"
  ],
  "database": {
    "models": [
      "Batch",
      "Measurement",
      "BatchMaterial",
      "LotSerialCounter",
      "LotSerialCounterLog"
    ]
  },
  "permissions": [
    "manager（開單、派工、完成、刪除）",
    "admin（開單、完成、刪除；不可派工）",
    "operator／qc（填寫、簽核）",
    "audit（只讀已完成批次）"
  ],
  "runtimeDependencies": {
    "python": [
      "fastapi",
      "sqlalchemy>=2",
      "pydantic>=2"
    ]
  },
  "subfeatures": [
    {
      "id": "batch-open-dispatch",
      "displayName": "開單與派工",
      "businessCapability": "管理者開立批次並指派負責人，派工後現場才能填寫。",
      "required": true,
      "defaultSelected": true,
      "options": [
        {
          "id": "require-assignment",
          "displayName": "開單必須指派負責人",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "id": "lot-pattern",
          "displayName": "批號樣板",
          "type": "string",
          "defaultValue": "L{variant}{region}{yy}{mm}{serial:03d}"
        },
        {
          "id": "lot-region-code",
          "displayName": "廠區碼",
          "type": "string",
          "defaultValue": ""
        },
        {
          "id": "lot-serial-reset",
          "displayName": "流水號歸零週期",
          "type": "string",
          "defaultValue": "never"
        }
      ]
    },
    {
      "id": "measurement-entry",
      "displayName": "站點量測填寫",
      "businessCapability": "依產品定義逐站逐項填寫量測值，重填會覆寫原值並留下操作人。",
      "required": true,
      "defaultSelected": true
    },
    {
      "id": "material-weighing",
      "displayName": "用料秤重",
      "businessCapability": "記錄各原料的料號、批號、供應商、理論與實際用量；現場操作員只能填實際用量。",
      "defaultSelected": true
    },
    {
      "id": "batch-signoff",
      "displayName": "操作員與檢驗員簽核",
      "businessCapability": "填完必要站點後，操作員與檢驗員各簽核一次，簽後不可取消。",
      "defaultSelected": true
    },
    {
      "id": "batch-completion",
      "displayName": "完成工單",
      "businessCapability": "簽核、必填項目、外部條件（例如報警結案）都齊全才可結案。",
      "required": true,
      "defaultSelected": true
    },
    {
      "id": "warehouse-entry",
      "displayName": "入庫單",
      "businessCapability": "每個批次一張入庫單，記錄入庫數量、單位、位置與明細（明細合計須等於數量）；送出後鎖定，可設定為結案前必須送出。",
      "defaultSelected": false,
      "options": [
        {
          "id": "requireWarehouseEntry",
          "displayName": "完成工單前須已送出入庫單",
          "type": "boolean",
          "defaultValue": false
        }
      ]
    },
    {
      "id": "rework-record",
      "displayName": "回鍋確認單",
      "businessCapability": "記錄回鍋的站點、數量與原因，由另一位主管確認；有待確認的回鍋單時不能結案。來源批次與併入總重的計算尚未提供。",
      "defaultSelected": false,
      "options": [
        {
          "id": "reworkConfirmerMustDiffer",
          "displayName": "確認者不可是填單者",
          "type": "boolean",
          "defaultValue": true
        },
        {
          "id": "blockOnPendingRework",
          "displayName": "有待確認回鍋單時擋完成",
          "type": "boolean",
          "defaultValue": true
        }
      ]
    },
    {
      "id": "batch-notes",
      "displayName": "子表格備註",
      "businessCapability": "可針對站點與步驟加備註，只增不改，留下完整紀錄。",
      "defaultSelected": false,
      "options": []
    },
    {
      "id": "attachments",
      "displayName": "照片佐證",
      "businessCapability": "依設定的附件欄位上傳照片（只收 JPEG、PNG、WebP，依檔頭判斷）；必附欄位未上傳不能結案。檔案放在平台提供的物件儲存，本 Kit 只保存參照。",
      "defaultSelected": false,
      "options": [
        {
          "id": "attachmentExtraKeys",
          "displayName": "額外允許的附件欄位",
          "type": "json",
          "defaultValue": []
        },
        {
          "id": "attachmentMaxBytes",
          "displayName": "單檔大小上限（位元組）",
          "type": "number",
          "defaultValue": 10485760
        }
      ]
    }
  ]
}