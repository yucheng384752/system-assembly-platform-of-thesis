{
  "kit": "audit-edit-kit",
  "provides": {
    "api": [
      { "capability": "audit.events.list", "method": "GET", "path": "/api/audit/events" },
      { "capability": "records.edit", "method": "PATCH", "path": "/api/edit/records/{table_code}/{record_id}" },
      { "capability": "edit-reasons.list", "method": "GET", "path": "/api/edit/reasons" },
      { "capability": "edit-reasons.create", "method": "POST", "path": "/api/edit/reasons" },
      { "capability": "edit-reasons.update", "method": "PATCH", "path": "/api/edit/reasons/{reason_id}" }
    ],
    "db": [
      { "capability": "db.audit.events" },
      { "capability": "db.edit-reasons.validate" }
    ]
  },
  "consumes": {
    "api": [],
    "db": ["db.records.search"]
  },
  "entryPoints": [
    {
      "key": "audit.events_read",
      "label": "查看稽核事件",
      "access": "read",
      "defaultRoles": [
        "admin",
        "manager",
        "audit"
      ],
      "routes": [
        {
          "capability": "audit.events.list",
          "method": "GET",
          "path": "/api/audit/events"
        }
      ]
    },
    {
      "key": "edit.reasons_read",
      "label": "查看修正原因",
      "access": "read",
      "defaultRoles": [
        "admin",
        "manager",
        "operator",
        "audit"
      ],
      "routes": [
        {
          "capability": "edit-reasons.list",
          "method": "GET",
          "path": "/api/edit/reasons"
        }
      ]
    },
    {
      "key": "edit.reasons_manage",
      "label": "維護修正原因",
      "access": "write",
      "defaultRoles": [
        "admin",
        "manager"
      ],
      "routes": [
        {
          "capability": "edit-reasons.create",
          "method": "POST",
          "path": "/api/edit/reasons"
        },
        {
          "capability": "edit-reasons.update",
          "method": "PATCH",
          "path": "/api/edit/reasons/{reason_id}"
        }
      ]
    },
    {
      "key": "edit.record_edit",
      "label": "修正資料列",
      "access": "write",
      "defaultRoles": [
        "admin",
        "manager"
      ],
      "routes": [
        {
          "capability": "records.edit",
          "method": "PATCH",
          "path": "/api/edit/records/{table_code}/{record_id}"
        }
      ]
    }
  ]
}
