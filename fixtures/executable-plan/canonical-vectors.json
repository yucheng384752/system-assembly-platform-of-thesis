{
  "note": "Cross-language vectors for planId canonicalization (contract section 5). The Python receiver must reproduce canonical and sha256 exactly.",
  "vectors": [
    {
      "name": "keys sort by UTF-16 code unit, not code point: an astral key precedes U+FFFF",
      "input": {
        "￿": 1,
        "😀": 2,
        "b": 3,
        "a": 4
      },
      "canonical": "{\"a\":4,\"b\":3,\"😀\":2,\"￿\":1}",
      "sha256": "93483ac1b498afad7577379bd98982187d34545ff97d8ca3d2b65fb9a8a7f8f3"
    },
    {
      "name": "numeric-looking keys are ordered as strings, arrays keep their order",
      "input": {
        "2": [
          3,
          1,
          2
        ],
        "9": 2,
        "10": 1
      },
      "canonical": "{\"10\":1,\"2\":[3,1,2],\"9\":2}",
      "sha256": "8815c2408181509b56188fbb9065617fe6ad6e854756c3d356b55a53d96153cc"
    },
    {
      "name": "integers and short decimals",
      "input": {
        "n": 12,
        "half": 0.5,
        "neg": -3
      },
      "canonical": "{\"half\":0.5,\"n\":12,\"neg\":-3}",
      "sha256": "4046b9cada749550ec2bdef0ee3c5241a76bf878216c7a022faa4da158826225"
    },
    {
      "name": "no Unicode normalization: decomposed and precomposed e-acute stay different",
      "input": {
        "decomposed": "é",
        "precomposed": "é"
      },
      "canonical": "{\"decomposed\":\"é\",\"precomposed\":\"é\"}",
      "sha256": "97252aace6e47c0acc408079c8959754b5d0c7c71ecb7b76e50d0984e58c1e0c"
    },
    {
      "name": "Traditional Chinese is hashed as UTF-8 as-is, no escaping",
      "input": {
        "名稱": "攪拌麵團"
      },
      "canonical": "{\"名稱\":\"攪拌麵團\"}",
      "sha256": "b8457c85fb092d5371ed3659f4c0b6912a893b7300053ae4a0c82fa0ee5ac52f"
    },
    {
      "name": "number formatting follows ECMAScript Number::toString: exponent form from 1e21 and below 1e-6",
      "input": {
        "big": 1e+21,
        "edge": 123456789012345680000,
        "small": 1e-7,
        "tiny": 5e-324,
        "boundary": 0.000001,
        "third": 0.3333333333333333,
        "max": 1.7976931348623157e+308
      },
      "canonical": "{\"big\":1e+21,\"boundary\":0.000001,\"edge\":123456789012345680000,\"max\":1.7976931348623157e+308,\"small\":1e-7,\"third\":0.3333333333333333,\"tiny\":5e-324}",
      "sha256": "37b348edf434739c9aa9369b378c838ae337417e9fa155f2a023b65448aef28c"
    },
    {
      "name": "negative zero and integral floats are written as plain integers",
      "input": {
        "negzero": 0,
        "whole": 12,
        "exp": 25000000000,
        "neg": -1.5e-10
      },
      "canonical": "{\"exp\":25000000000,\"neg\":-1.5e-10,\"negzero\":0,\"whole\":12}",
      "sha256": "6b2899856a8cb684232375d975ce0add18d815a9388e0687b3f97acda7a196e3"
    },
    {
      "name": "control characters use lowercase unicode escapes; quote, backslash and DEL stay as JSON.stringify writes them",
      "input": {
        "s": "a\u0001\u001f\b\f\n\r\t\"\\"
      },
      "canonical": "{\"s\":\"a\\u0001\\u001f\\b\\f\\n\\r\\t\\\"\\\\\"}",
      "sha256": "571819d283e31a39d58bbca1eb89d409a59079fe748791cc8a423686573e98ca"
