{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WP3b system-manifest extension DRAFT; not an edit to existing schemas",
  "type": "object",
  "required": ["systemVersion", "images"],
  "properties": {
    "systemVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "images": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "tag", "archive", "services"],
        "properties": {
          "id": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "tag": { "type": "string", "minLength": 1 },
          "archive": { "type": "string", "minLength": 1 },
          "services": { "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "enum": ["postgres", "backend", "init", "proxy"] } }
        }
      }
    }
  }
}
