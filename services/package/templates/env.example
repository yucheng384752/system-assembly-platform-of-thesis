# Field inventory only. Supply values through the installer's protected input.
# SYSTEM_ID: tenant name and code, nonempty, at most 50 characters
SYSTEM_ID=
# DEFAULT_TENANT_ID: UUID of the single default tenant
DEFAULT_TENANT_ID=
# PostgreSQL initialization user, database, and private password
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=
# DATABASE_URL: asyncpg PostgreSQL URL using host postgres and port 5432;
# match POSTGRES_USER/POSTGRES_DB and percent-encode the private password.
DATABASE_URL=
# SECRET_KEY: private random key, minimum 32 characters
SECRET_KEY=
# ENTRY_PERMISSION_JWT_SECRET: private random JWT key, minimum 32 characters
ENTRY_PERMISSION_JWT_SECRET=
@@WEBHOOK_EXAMPLE@@# PROXY_BIND: optional; Compose defaults to loopback
PROXY_BIND=
# HTTP_PORT: optional; Compose defaults to 8080
HTTP_PORT=
