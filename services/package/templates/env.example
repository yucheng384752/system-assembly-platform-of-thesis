# Field inventory only. Supply values through the installer's protected input.
# SYSTEM_ID: tenant name and code, nonempty, at most 50 characters
SYSTEM_ID=
# DEFAULT_TENANT_ID: UUID of the single default tenant
DEFAULT_TENANT_ID=
# PostgreSQL initialization user and database (not secret)
POSTGRES_USER=
POSTGRES_DB=
# Host paths mounted into the backend (absolute, not secret): the license directory (writable by UID 10001),
# the trusted root public key file, and the installed system-manifest.json.
LICENSE_DIR=
ROOT_KEY_FILE=
MANIFEST_FILE=
# Private values are NOT environment variables. Provide them as files in ../secrets/ (one value per file,
# readable by UID 10001, mode 0400): postgres_password, database_url, secret_key, entry_permission_jwt_secret
# (and mod_webhook_secret when the package includes mod-subscription-kit).
# database_url: asyncpg PostgreSQL URL using host postgres and port 5432; match POSTGRES_USER/POSTGRES_DB and
# percent-encode the password. secret_key and entry_permission_jwt_secret: random, at least 32 characters.
# LICENSE_BLOCK_WINDOW: optional; when a hardware mismatch may start blocking the system, in the site's local time
# (default 'mon-fri 09:00-15:00'). LICENSE_TIMEZONE: optional IANA zone for that window (default Asia/Taipei).
LICENSE_BLOCK_WINDOW=
LICENSE_TIMEZONE=
# PROXY_BIND: optional; Compose defaults to loopback
PROXY_BIND=
# HTTP_PORT: optional; Compose defaults to 8080
HTTP_PORT=
