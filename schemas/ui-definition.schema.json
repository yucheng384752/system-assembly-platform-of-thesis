{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.form-system-kit-composer/schemas/ui-definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kitId",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kitId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "components": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "subfeature_id",
              "title",
              "type",
              "source_ref",
              "columns"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "subfeature_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "table"
              },
              "source_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "field",
                    "label",
                    "visible",
                    "order",
                    "width",
                    "renderer"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "visible": {
                      "type": "boolean"
                    },
                    "order": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 99
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 60,
                      "maximum": 600
                    },
                    "renderer": {
                      "const": "text"
                    }
                  }
                },
                "minItems": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "subfeature_id",
              "title",
              "type",
              "options",
              "defaultValue",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "subfeature_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "const": "select"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "value",
                    "displayName"
                  ],
                  "properties": {
                    "value": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "displayName": {
                      "type": "string",
                      "maxLength": 100
                    }
                  }
                },
                "minItems": 1,
                "maxItems": 30
              },
              "defaultValue": {
                "type": "string"
              },
              "action": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "target_component_id",
                  "field"
                ],
                "properties": {
                  "type": {
                    "const": "filter"
                  },
                  "target_component_id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  },
                  "field": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
