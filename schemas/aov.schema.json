{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Composer AoV Workflow document",
  "description": "Version 5 adds factories (each holding production-logic graphs) and start and end nodes in every graph (D78-D82). Version 4 is a graph of nodes with sub-graphs, node-owned forms and field validation (D70-D73). Version 3 adds the actions of each step (D66). Version 2 carries steps, form definitions and confirmed form relations (spec 4.2, D16-D29). Version 1 (steps only) remains importable.",
  "oneOf": [{ "$ref": "#/$defs/v5" }, { "$ref": "#/$defs/v4" }, { "$ref": "#/$defs/v3" }, { "$ref": "#/$defs/v2" }, { "$ref": "#/$defs/v1" }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "v1": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "steps"],
      "properties": {
        "format": { "const": "composer-aov-list" },
        "version": { "const": 1 },
        "steps": { "type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "when", "owner", "formId"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "when": { "type": "string", "maxLength": 300 },
            "owner": { "type": "string", "maxLength": 100 },
            "formId": { "type": "string", "maxLength": 100 }
          }
        } }
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["formId", "fieldId"],
      "properties": { "formId": { "$ref": "#/$defs/id" }, "fieldId": { "$ref": "#/$defs/id" } }
    },
    "formIds": { "type": "array", "uniqueItems": true, "maxItems": 50, "items": { "$ref": "#/$defs/id" } },
    "forms": { "type": "array", "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "fields": { "type": "array", "minItems": 1, "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "type", "required", "isKey"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "type": { "enum": ["text", "integer", "decimal", "boolean", "date"] },
            "required": { "type": "boolean" },
            "isKey": { "type": "boolean" }
          }
        } }
      }
    } },
    "relations": { "type": "array", "maxItems": 1225, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "from", "to", "origin", "confirmed"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "shared-key" },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "origin": { "enum": ["inferred", "user"] },
        "confirmed": { "const": true }
      }
    } },
    "v2": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "steps", "forms", "relations"],
      "properties": {
        "format": { "const": "composer-aov-list" },
        "version": { "const": 2 },
        "steps": { "type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "when", "owner", "formIds"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "when": { "type": "string", "maxLength": 300 },
            "owner": { "type": "string", "maxLength": 100 },
            "formIds": { "$ref": "#/$defs/formIds" }
          }
        } },
        "forms": { "$ref": "#/$defs/forms" },
        "relations": { "$ref": "#/$defs/relations" }
      }
    },
    "isoDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "validation": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "allowedValues": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "minimumDate": { "$ref": "#/$defs/isoDate" },
        "maximumDate": { "$ref": "#/$defs/isoDate" }
      }
    },
    "formsV4": { "type": "array", "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "fields": { "type": "array", "minItems": 1, "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "type", "required", "isKey"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "type": { "enum": ["text", "integer", "decimal", "boolean", "date"] },
            "required": { "type": "boolean" },
            "isKey": { "type": "boolean" },
            "validation": { "$ref": "#/$defs/validation" }
          }
        } }
      }
    } },
    "position": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": { "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 }, "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 } }
    },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "when", "owner", "actionId", "params", "formId", "childGraphId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "when": { "type": "string", "maxLength": 300 },
        "owner": { "type": "string", "maxLength": 100 },
        "actionId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "params": { "type": "object", "maxProperties": 20, "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9]*$", "maxLength": 50 },
          "additionalProperties": { "type": ["string", "number", "boolean"], "maxLength": 100 } },
        "formId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "childGraphId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }
      }
    },
    "nodeV5": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "name", "when", "owner", "actionId", "params", "formId", "childGraphId"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["start", "end", "node"] },
        "name": { "$ref": "#/$defs/name" },
        "when": { "type": "string", "maxLength": 300 },
        "owner": { "type": "string", "maxLength": 100 },
        "actionId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "params": { "type": "object", "maxProperties": 20, "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9]*$", "maxLength": 50 },
          "additionalProperties": { "type": ["string", "number", "boolean"], "maxLength": 100 } },
        "formId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "childGraphId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }
      }
    },
    "v5": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "factories", "graphs", "layout", "forms", "relations"],
      "properties": {
        "format": { "const": "composer-aov-list" },
        "version": { "const": 5 },
        "factories": { "type": "array", "maxItems": 20, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "logicGraphIds"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "logicGraphIds": { "type": "array", "uniqueItems": true, "maxItems": 20, "items": { "$ref": "#/$defs/id" } }
          }
        } },
        "graphs": { "type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "nodes", "edges"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "nodes": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/nodeV5" } },
            "edges": { "type": "array", "maxItems": 500, "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "from", "to"],
              "properties": { "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" } }
            } }
          }
        } },
        "layout": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/position" } } },
        "forms": { "$ref": "#/$defs/formsV4" },
        "relations": { "$ref": "#/$defs/relations" }
      }
    },
    "v4": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "rootGraphId", "graphs", "layout", "forms", "relations"],
      "properties": {
        "format": { "const": "composer-aov-list" },
        "version": { "const": 4 },
        "rootGraphId": { "$ref": "#/$defs/id" },
        "graphs": { "type": "array", "minItems": 1, "maxItems": 30, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "nodes", "edges"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "nodes": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/node" } },
            "edges": { "type": "array", "maxItems": 500, "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "from", "to"],
              "properties": { "id": { "$ref": "#/$defs/id" }, "from": { "$ref": "#/$defs/id" }, "to": { "$ref": "#/$defs/id" } }
            } }
          }
        } },
        "layout": { "type": "object", "additionalProperties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/position" } } },
        "forms": { "$ref": "#/$defs/formsV4" },
        "relations": { "$ref": "#/$defs/relations" }
      }
    },
    "v3": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "steps", "forms", "relations"],
      "properties": {
        "format": { "const": "composer-aov-list" },
        "version": { "const": 3 },
        "steps": { "type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "when", "owner", "formIds", "actions"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "when": { "type": "string", "maxLength": 300 },
            "owner": { "type": "string", "maxLength": 100 },
            "formIds": { "$ref": "#/$defs/formIds" },
            "actions": { "type": "array", "maxItems": 50, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["actionId", "formIds"],
              "properties": { "actionId": { "$ref": "#/$defs/id" }, "formIds": { "$ref": "#/$defs/formIds" } }
            } }
          }
        } },
        "forms": { "$ref": "#/$defs/forms" },
        "relations": { "$ref": "#/$defs/relations" }
      }
    }
  }
}
