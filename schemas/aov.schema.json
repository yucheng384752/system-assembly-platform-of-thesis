{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Composer AoV Workflow document",
  "description": "Version 3 adds the actions of each step (D66). Version 2 carries steps, form definitions and confirmed form relations (spec 4.2, D16-D29). Version 1 (steps only) remains importable.",
  "oneOf": [{ "$ref": "#/$defs/v3" }, { "$ref": "#/$defs/v2" }, { "$ref": "#/$defs/v1" }],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "maxLength": 100 },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "v1": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "steps"],
      "properties": {
        "format": { "const": "composer-aov-list" },
        "version": { "const": 1 },
        "steps": { "type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "when", "owner", "formId"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "when": { "type": "string", "maxLength": 300 },
            "owner": { "type": "string", "maxLength": 100 },
            "formId": { "type": "string", "maxLength": 100 }
          }
        } }
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["formId", "fieldId"],
      "properties": { "formId": { "$ref": "#/$defs/id" }, "fieldId": { "$ref": "#/$defs/id" } }
    },
    "formIds": { "type": "array", "uniqueItems": true, "maxItems": 50, "items": { "$ref": "#/$defs/id" } },
    "forms": { "type": "array", "maxItems": 50, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "fields"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/name" },
        "fields": { "type": "array", "minItems": 1, "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "type", "required", "isKey"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "type": { "enum": ["text", "integer", "decimal", "boolean", "date"] },
            "required": { "type": "boolean" },
            "isKey": { "type": "boolean" }
          }
        } }
      }
    } },
    "relations": { "type": "array", "maxItems": 1225, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "from", "to", "origin", "confirmed"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "const": "shared-key" },
        "from": { "$ref": "#/$defs/endpoint" },
        "to": { "$ref": "#/$defs/endpoint" },
        "origin": { "enum": ["inferred", "user"] },
        "confirmed": { "const": true }
      }
    } },
    "v2": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "steps", "forms", "relations"],
      "properties": {
        "format": { "const": "composer-aov-list" },
        "version": { "const": 2 },
        "steps": { "type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "when", "owner", "formIds"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "when": { "type": "string", "maxLength": 300 },
            "owner": { "type": "string", "maxLength": 100 },
            "formIds": { "$ref": "#/$defs/formIds" }
          }
        } },
        "forms": { "$ref": "#/$defs/forms" },
        "relations": { "$ref": "#/$defs/relations" }
      }
    },
    "v3": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "steps", "forms", "relations"],
      "properties": {
        "format": { "const": "composer-aov-list" },
        "version": { "const": 3 },
        "steps": { "type": "array", "maxItems": 100, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "name", "when", "owner", "formIds", "actions"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "name": { "$ref": "#/$defs/name" },
            "when": { "type": "string", "maxLength": 300 },
            "owner": { "type": "string", "maxLength": 100 },
            "formIds": { "$ref": "#/$defs/formIds" },
            "actions": { "type": "array", "maxItems": 50, "items": {
              "type": "object", "additionalProperties": false,
              "required": ["actionId", "formIds"],
              "properties": { "actionId": { "$ref": "#/$defs/id" }, "formIds": { "$ref": "#/$defs/formIds" } }
            } }
          }
        } },
        "forms": { "$ref": "#/$defs/forms" },
        "relations": { "$ref": "#/$defs/relations" }
      }
    }
  }
}
