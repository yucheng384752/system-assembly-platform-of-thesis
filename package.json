{
  "name": "composer-refactor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --configLoader native && node --test services/preview/tests/preview.test.mjs",
    "test:kits": ".venv\\Scripts\\python -B -m pytest -p no:cacheprovider -q kits/platform-core-kit/tests"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.4",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
