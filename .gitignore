node_modules/
dist/
packages/*
!packages/.gitkeep
manuals/generated/*
!manuals/generated/.gitkeep
.venv/
# Signing keys, licenses and signatures never belong in the repo (D40).
*.pem
license.lic
*.sig.json
# Temporary directories created by services/package tests (a failed cleanup must never reach a commit).
services/package/tests/.*/
